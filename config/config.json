        "separate_messages": false
      },
      "split_on_marker": false,
      "turn_profile": {
        "enabled": false,
        "history": {},
        "system_prompt": {},
        "skills": {},
        "tools": {}
      },
      "max_llm_retries": 2,
      "llm_retry_backoff_secs": 2
